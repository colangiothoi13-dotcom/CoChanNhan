{
  "name": "cotienlo-mobile-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "play:world": "npm run build && npm run server",
    "test:world": "node --test server/*.test.mjs",
    "test:cultivation": "node --test shared/cultivation-core.test.mjs",
    "test:resources": "node --test shared/resource-core.test.mjs",
    "build": "tsc && vite build",
    "build:android": "npm run build && node scripts/sync-android-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:assets": "node --test scripts/sync-android-assets.check.mjs",
    "test:auth": "node --test server/auth*.test.mjs server/email-transport.test.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.5"
  }
}
