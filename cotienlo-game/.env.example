# Copy to .env on the server. Never put these values in VITE_* variables or the APK.
# Gmail with 2-Step Verification and a Google App Password (not the Gmail login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional; defaults to SMTP_USER.
SMTP_FROM=
# PORT=8787
# HOST=127.0.0.1
# WORLD_ALLOWED_ORIGINS=https://your-game.example
# Require verified Gmail for all shared-world play; enable when SMTP is configured.
# WORLD_REQUIRE_AUTH=true
